{
    "name": "jardissupport/auth",
    "homepage": "https://jardis.io",
    "description": "Opaque token management with SQL token store and token authentication (subject + tenant), session handling, password hashing, and role-based access control for PHP DDD applications — framework-free, no JWT, no third-party runtime dependencies beyond PHP built-ins and the Jardis contracts and dbquery packages",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "jardissupport/contracts": "^2.8",
        "jardissupport/dbquery": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.2.3",
        "squizlabs/php_codesniffer": "3.13.6",
        "jardisadapter/dbconnection": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\Auth\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/auth/issues",
        "docs": "https://docs.jardis.io/en/support/auth",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "auth",
        "authentication",
        "authorization",
        "rbac",
        "access-control",
        "password-hashing",
        "token",
        "session",
        "security",
        "php",
        "domain-driven-design",
        "hexagonal-architecture",
        "jardis",
        "headgent"
    ]
}
